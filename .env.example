# Flask core
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key

# Database
# Dev default (SQLite) is used automatically if DATABASE_URL is not set.
# For production (Render/PostgreSQL) set something like:
# DATABASE_URL=postgresql://user:password@host:5432/smartcare_db
DATABASE_URL=

# Mail (Flask-Mail) — example values for Gmail SMTP
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=SmartCare X <your-email@gmail.com>

# File uploads
MAX_CONTENT_LENGTH_MB=5
UPLOAD_FOLDER=smartcare/static/uploads

# Pagination
ITEMS_PER_PAGE=10
